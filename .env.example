# Copy to .env and fill in. .env is git-ignored.

# Free key from https://www.football-data.org/client/register
# Used only by the API container. Never prefix it with VITE_ (that would ship it to the browser).
FOOTBALL_DATA_API_KEY=

# Async SQLAlchemy URL. "db" is the Postgres service name inside Docker Compose.
DATABASE_URL=postgresql+asyncpg://football:football@db:5432/football

# Where the browser reaches the API.
VITE_API_URL=http://localhost:8000

# Optional: change if port 5432 is already taken on your machine.
# DB_HOST_PORT=5432
